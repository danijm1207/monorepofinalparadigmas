# ==============================================================================
# Variables de Entorno de Ejemplo - Sistema de Investigación Criminal
# ==============================================================================
# IMPORTANTE: Copia este archivo a .env para desarrollo local.
# NUNCA incluyas secretos de producción en el repositorio.

# Puerto interno del servidor Javalin
PORT=8080

# Base de datos PostgreSQL
DATABASE_URL=jdbc:postgresql://postgres:5432/investigacion
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_password_change_me
DB_POOL_SIZE=10

# Autenticación JWT (HS256)
# OBLIGATORIA: la aplicación fallará al arrancar si no está definida.
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_at_least_256_bits_long
JWT_EXPIRES_IN_HOURS=24

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8083

# Almacenamiento local de archivos e imágenes
UPLOAD_DIR=/data/uploads

# URL base pública para construir enlaces a archivos estáticos (/uploads)
# Java: http://localhost:8081 | Scala: http://localhost:8082 | Kotlin: http://localhost:8083
PUBLIC_BASE_URL=http://localhost:8081
