# Secretos y variables locales
.env
.env.local
*.env

# Python / Pytest / Virtualenv
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# Java / Kotlin (Gradle)
.gradle/
build/
!backends/*/src/**/build
out/
gradle/wrapper/gradle-wrapper.jar

# Scala (sbt)
target/
project/target/
project/project/
.bloop/
.metals/

# Archivos de IDE y Editores
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
