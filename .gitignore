# Docker / Volúmenes locales y uploads
/data/uploads/*
!/data/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Resultados crudos locales (muy pesados, se preserva carpeta con .gitkeep)
results/raw/*
!results/raw/.gitkeep

# Logs y OS
*.log
.DS_Store
Thumbs.db
Desktop.ini
